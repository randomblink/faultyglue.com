<!-- /Volumes/Storage/Projects/faultyglue.com/app/views/posts/index.html.erb -->
<h1>Blog</h1>
<p>Oldest posts first.</p>

<% if @posts.any? %>
  <div class="post-list">
    <% @posts.each do |post| %>
      <article class="post-card">
        <header class="post-card__header">
          <h2 class="post-card__title">
            <%= link_to post.title.to_s, post_path(post) %>
          </h2>

          <div class="post-card__meta">
            <%# Readers can see dates; status is useful to you, but optional to show publicly %>
            <span><strong>Created:</strong> <%= post.created_at.strftime("%B %d, %Y") %></span>
            <% if post.published_at.present? %>
              <span class="dot">•</span>
              <span><strong>Published:</strong> <%= post.published_at.strftime("%B %d, %Y") %></span>
            <% end %>

            <% if authenticated? %>
              <span class="dot">•</span>
              <span><strong>Status:</strong> <%= post.status %></span>
            <% end %>
          </div>
        </header>

        <% if post.excerpt.present? %>
          <p class="post-card__excerpt"><%= post.excerpt %></p>
        <% elsif post.body.present? %>
          <p class="post-card__excerpt"><%= truncate(strip_tags(post.body.to_s), length: 220) %></p>
        <% end %>

        <div class="post-card__actions">
          <%= link_to "Read", post_path(post), class: "btn" %>
          <% if authenticated? %>
            <%= link_to "Edit", edit_post_path(post), class: "btn" %>
          <% end %>
        </div>
      </article>
    <% end %>
  </div>
<% else %>
  <p>No blog posts yet.</p>

  <% if authenticated? %>
    <p><%= link_to "Create the first post", new_post_path, class: "btn" %></p>
  <% end %>
<% end %>
